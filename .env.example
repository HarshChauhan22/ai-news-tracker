# Copy to .env and fill in. Never commit .env.

# LLM (Gemini) - extraction and release detection
GEMINI_API_KEY=
# Google retires Gemini models and some get overloaded. If the primary keeps failing, the
# agent falls back to the second. On 404 NOT_FOUND, pick a current model here.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Search (Tavily)
TAVILY_API_KEY=

# Google Sheets (service account). Share the sheet with the service
# account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=

# Gmail API (OAuth client). Run `python agent.py --auth` once to create token.json.
GMAIL_OAUTH_CLIENT_FILE=client_secret.json
# Where new-model alerts are sent (required).
ALERT_TO_EMAIL=

# Schedule: daily at this time, in this timezone (IANA name)
SCHEDULE_HOUR=10
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=Asia/Kolkata
